# Database connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://savepass_user:savepass_password@localhost:5432/savepass

# Fernet encryption key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT configuration
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# Allowed CORS origins (comma-separated for multiple)
# Example: http://localhost:5173,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173
