# Database connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://savepass_user:savepass_password@localhost:5432/savepass

# Fernet encryption key — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# JWT configuration — the backend refuses to start if JWT_SECRET is missing
# or shorter than 32 characters. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15

# Allowed CORS origins (comma-separated for multiple)
# Example: http://localhost:5173,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173

# Session refresh cookie (httpOnly). Hours a login stays valid without re-entering the password.
REFRESH_EXPIRE_HOURS=8
# Keep "true": browsers accept Secure cookies on http://localhost too.
COOKIE_SECURE=true
# "strict" works when frontend and API share a site (e.g. localhost, app.example.com + api.example.com).
COOKIE_SAMESITE=strict

# Profile given to new sign-ups (Basic = view only, Full = view/save/edit/delete)
DEFAULT_PROFILE=Full

# Rate limiting. Use a shared store (e.g. redis://redis:6379) with more than one worker.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=memory://
