# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it).

# Public hostname. A real domain gets a Let's Encrypt certificate automatically;
# "localhost" uses Caddy's internal CA (local smoke tests only).
SITE_ADDRESS=vault.example.com

# Database passwords (generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))")
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# During a key rotation: "<new>,<old>" (see ARCHITECTURE.md › Fernet key management)
FERNET_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

REFRESH_EXPIRE_HOURS=8
DEFAULT_PROFILE=Full
RATE_LIMIT_STORAGE=memory://
