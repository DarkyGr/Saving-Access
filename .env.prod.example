# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it).

# Public hostname. A real domain gets a Let's Encrypt certificate automatically;
# "localhost" uses Caddy's internal CA (local smoke tests only).
SITE_ADDRESS=vault.example.com

# Database passwords (generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))")
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# During a key rotation: "<new>,<old>" (see ARCHITECTURE.md › Fernet key management)
FERNET_KEY=

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

REFRESH_EXPIRE_HOURS=8
DEFAULT_PROFILE=Full
RATE_LIMIT_STORAGE=memory://

# ── Spec Phase 2 (optional, off by default) ────────────────────────────────
# Email verification: new accounts must verify their email within 30 days or
# they are deactivated (python -m app.cli verify-email --username X reactivates).
EMAIL_VERIFICATION_ENABLED=false
# console (prints emails to the log) | smtp | file (EMAIL_OUTBOX_DIR, tests)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Save-Pass <noreply@example.com>
# hCaptcha on the login page (https://dashboard.hcaptcha.com). Set both or neither.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
